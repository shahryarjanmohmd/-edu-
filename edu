            }

            save_requests(requests, request_count);

            printf("All pending requests approved.\n");
            printf("Press enter to go back...");
            getchar();
            getchar();
            break;

        } else if (choice == 3) {
            // Go back
            break;

        } else {
            printf("Invalid option.\n");
            printf("Press enter to continue...");
            getchar();
            getchar();
        }

        // اگر دیگر هیچ درخواست pending نمانده باشد، از حلقه خارج می‌شویم
        if (pending_count == 0) {
            printf("No more pending requests.\n");
